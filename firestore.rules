rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'lasasdias11@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function validNonNegativeNumber(value) {
      return value is number && value >= 0;
    }

    function validCommissionRates(data) {
      return data.keys().hasOnly(['AIRTEL', 'DIALOG', 'MOBITEL', 'HUTCH']) &&
        validNonNegativeNumber(data.AIRTEL) &&
        validNonNegativeNumber(data.DIALOG) &&
        validNonNegativeNumber(data.MOBITEL) &&
        validNonNegativeNumber(data.HUTCH);
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasOnly(['email', 'role', 'createdAt', 'updatedAt']) &&
        request.resource.data.email is string &&
        request.resource.data.role in ['admin', 'staff'];
      allow delete: if isAdmin();
    }

    match /inventory/{itemId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
        request.resource.data.code is string &&
        request.resource.data.code.size() > 0 &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.category is string &&
        request.resource.data.itemType in ['product', 'service'] &&
        validNonNegativeNumber(request.resource.data.sellingPrice) &&
        validNonNegativeNumber(request.resource.data.costPrice) &&
        validNonNegativeNumber(request.resource.data.stockQuantity) &&
        validNonNegativeNumber(request.resource.data.lowStockThreshold);
      allow delete: if isAdmin();
    }

    match /stationery_transactions/{transactionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.itemCode is string &&
        request.resource.data.itemName is string &&
        request.resource.data.category is string &&
        request.resource.data.itemType in ['product', 'service'] &&
        validNonNegativeNumber(request.resource.data.sellingPrice) &&
        validNonNegativeNumber(request.resource.data.costPrice) &&
        request.resource.data.unitProfit is number &&
        request.resource.data.profit is number &&
        request.resource.data.quantity is number &&
        request.resource.data.quantity > 0 &&
        validNonNegativeNumber(request.resource.data.totalAmount) &&
        request.resource.data.date is string;
      allow update: if isAuthenticated() &&
        request.resource.data.itemCode is string &&
        request.resource.data.itemName is string &&
        request.resource.data.itemType in ['product', 'service'] &&
        validNonNegativeNumber(request.resource.data.sellingPrice) &&
        validNonNegativeNumber(request.resource.data.costPrice) &&
        request.resource.data.unitProfit is number &&
        request.resource.data.profit is number &&
        request.resource.data.quantity is number &&
        request.resource.data.quantity > 0 &&
        validNonNegativeNumber(request.resource.data.totalAmount) &&
        request.resource.data.date is string;
      allow delete: if isAuthenticated();
    }

    match /reload_transactions/{reloadId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.operator in ['AIRTEL', 'DIALOG', 'MOBITEL', 'HUTCH'] &&
        validNonNegativeNumber(request.resource.data.amount) &&
        request.resource.data.amount > 0 &&
        validNonNegativeNumber(request.resource.data.commissionRate) &&
        validNonNegativeNumber(request.resource.data.commissionAmount) &&
        request.resource.data.date is string;
      allow update: if isAuthenticated() &&
        request.resource.data.operator in ['AIRTEL', 'DIALOG', 'MOBITEL', 'HUTCH'] &&
        validNonNegativeNumber(request.resource.data.amount) &&
        request.resource.data.amount > 0 &&
        validNonNegativeNumber(request.resource.data.commissionRate) &&
        validNonNegativeNumber(request.resource.data.commissionAmount) &&
        request.resource.data.date is string;
      allow delete: if isAuthenticated();
    }

    match /settings/{settingDoc} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() && (
        (settingDoc == 'rates' && validCommissionRates(request.resource.data)) ||
        (settingDoc == 'presets' &&
          request.resource.data.keys().hasOnly(['list']) &&
          request.resource.data.list is list)
      );
      allow delete: if isAdmin();
    }

    match /diagnostics/{diagId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.test is string &&
        request.resource.data.timestamp is timestamp;
    }

    match /system_health/{healthDoc} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
