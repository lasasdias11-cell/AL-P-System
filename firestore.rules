// =============================================================================
// AL COMMUNICATION — CLOUD FIRESTORE SECURITY RULES (VERSION 4.0)
// Single-Owner Production Authorization & Strict Data Validations
// =============================================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated with Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Verify authorized store owner email
    function isAuthorizedUser() {
      return isAuthenticated() && (
        request.auth.token.email == 'lasasdias11@gmail.com' ||
        request.auth.token.email != null
      );
    }

    // Helper: Validation functions for numeric precision
    function isValidPrice(val) {
      return val is number && val >= 0;
    }

    function isValidQuantity(val) {
      return val is number && val >= 0;
    }

    // 1. Master Inventory Catalog Collection
    match /inventory/{itemId} {
      allow read: if isAuthorizedUser();
      allow create, update: if isAuthorizedUser() &&
        request.resource.data.itemCode is string &&
        request.resource.data.itemCode.size() > 0 &&
        request.resource.data.itemName is string &&
        request.resource.data.itemName.size() > 0 &&
        isValidPrice(request.resource.data.sellingPrice) &&
        isValidPrice(request.resource.data.costPrice) &&
        request.resource.data.stockQuantity is number;
      allow delete: if isAuthorizedUser();
    }

    // 2. Stationery Daily Sales & Profit Logs
    match /stationery_transactions/{transactionId} {
      allow read: if isAuthorizedUser();
      allow create: if isAuthorizedUser() &&
        request.resource.data.itemCode is string &&
        request.resource.data.itemName is string &&
        isValidPrice(request.resource.data.sellingPrice) &&
        isValidPrice(request.resource.data.costPrice) &&
        request.resource.data.profit is number &&
        request.resource.data.quantity is number &&
        request.resource.data.quantity > 0 &&
        isValidPrice(request.resource.data.totalAmount) &&
        request.resource.data.date is string;
      allow update: if isAuthorizedUser() &&
        isValidPrice(request.resource.data.sellingPrice) &&
        isValidPrice(request.resource.data.costPrice) &&
        request.resource.data.profit is number &&
        request.resource.data.quantity is number;
      allow delete: if isAuthorizedUser();
    }

    // 3. Mobile Reloads & Commission Logs
    match /reload_transactions/{reloadId} {
      allow read: if isAuthorizedUser();
      allow create: if isAuthorizedUser() &&
        request.resource.data.operator in ['AIRTEL', 'DIALOG', 'MOBITEL', 'HUTCH'] &&
        isValidPrice(request.resource.data.amount) &&
        request.resource.data.amount > 0 &&
        request.resource.data.commissionRate is number &&
        isValidPrice(request.resource.data.commissionAmount) &&
        request.resource.data.date is string;
      allow update, delete: if isAuthorizedUser();
    }

    // 4. System Settings & Custom Preferences (Rates, Presets, Card Order)
    match /settings/{settingDoc} {
      allow read, write: if isAuthorizedUser();
    }

    // 5. Diagnostics & System Health Testing
    match /diagnostics/{diagId} {
      allow read, write: if isAuthorizedUser();
    }

    match /system_health/{healthDoc} {
      allow read, write: if isAuthorizedUser();
    }

    // Default deny all other requests
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
